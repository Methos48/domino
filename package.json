{
  "name": "anotador-domino",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');for(const f of ['index.html','sw.js','manifest.json','icon.svg','imagen','lib'])fs.cpSync(f,'www/'+f,{recursive:true})\"",
    "sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0"
  }
}
